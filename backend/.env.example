# Copiá este archivo a backend/.env y completá los valores. NUNCA subas el .env real a git.

# Servidor
PORT=4000

# PostgreSQL (alternativa: una sola variable DATABASE_URL=postgresql://usuario:clave@host:5432/comitrack)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_NAME=comitrack
# DB_SSL=true

# Autenticacion (usá una clave larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_privada

# Correo SMTP para enviar enlaces de verificacion y recuperacion de contraseña
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM=ComiTrack <tu_cuenta@gmail.com>
FRONTEND_URL=http://localhost:5173

# IA (opcional, para etapas mas avanzadas)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
