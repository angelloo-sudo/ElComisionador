{
  "name": "comitrack-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de ComiTrack (Node.js + Express + PostgreSQL)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "localidades": "node scripts/generar-localidades.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:create": "node scripts/migrate.js create",
    "migrate:baseline": "node scripts/migrate.js baseline",
    "test:auth": "node --test test/auth.integration.test.js",
    "test:encomiendas": "node --test test/encomiendas.integration.test.js",
    "test:gastos": "node --test test/gasto-validador.test.js test/gastos.integration.test.js",
    "test:auth:10": "node test/run-auth-10.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
