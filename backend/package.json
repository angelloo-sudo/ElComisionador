{
  "name": "comitrack-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de ComiTrack (Node.js + Express + PostgreSQL)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "localidades": "node scripts/generar-localidades.js",
    "seed": "node scripts/seed.js",
    "seed:test": "node scripts/seed-test-data.js",
    "test:tarifa": "node --test test/tarifa.integration.test.js",
    "test:tramo": "node --test test/tramo.service.test.js",
    "test:paradas": "node --test test/paradas.service.test.js",
    "test:geo": "node --test test/geo.service.test.js",
    "test:auth": "node --test test/auth.integration.test.js",
    "test:encomiendas": "node --test test/encomiendas.integration.test.js",
    "test:solicitud-validador": "node --test test/solicitud.validador.test.js",
    "test:viaje-validador": "node --test test/viaje.validador.test.js",
    "test:recordatorio": "node --test test/recordatorio.validador.test.js",
    "test:recordatorio:integration": "node --test test/recordatorio.integration.test.js",
    "test:viajes-estado": "node --test test/viajes-estado.integration.test.js",
    "test:retiro": "node --test test/solicitud-retiro.integration.test.js",
    "test:pasajero": "node --test test/pasajero-estado.integration.test.js",
    "test:ingresos": "node --test test/ingresos.integration.test.js",
    "test:rentabilidad": "node --test test/rentabilidad.test.js test/rentabilidad.integration.test.js test/reportes-rentabilidad.integration.test.js",
    "test:graficos-rentabilidad": "node --test test/graficos-rentabilidad.test.js",
    "test:graficos-rentabilidad:integration": "node --test test/graficos-rentabilidad.integration.test.js",
    "test:reportes-filtros": "node --test test/reportes-filtros.test.js",
    "test:gastos": "node --test test/gasto-validador.test.js test/gastos.integration.test.js",
    "test:verificaciones": "node --test test/verificacion.validador.test.js test/verificaciones.integration.test.js",
    "test:historiales": "node --test test/historial-filtros.test.js test/historial-auth.test.js",
    "test:historiales:integration": "node --test test/historial.integration.test.js",
    "test:auth:10": "node test/run-auth-10.mjs",
    "test:busqueda-viajes-ia": "node --test test/busqueda-viajes-ia.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
